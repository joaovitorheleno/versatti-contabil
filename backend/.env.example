# AMBIENTE DE DESENVOLVIMENTO LOCAL

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

DB_TYPE=
NODE_ENV=

JWT_SECRET=
REDIS_URL=

# ENVIO DE E-MAIL (SMTP)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 e uma "senha de app" em SMTP_PASS

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Versatti Contabilidade <nao-responda@seudominio.com.br>"

# PRODUÇÃO (Railway)
# Use DATABASE_URL no lugar das DB_*; DB_SSL=true só se conectar pela URL pública do banco
DATABASE_URL=
DB_SSL=false
# Domínios do front que podem chamar a API, separados por vírgula
CORS_ORIGINS=https://seu-front.vercel.app
# Pasta dos arquivos enviados; em produção aponte para o volume persistente
STORAGE_PATH=/data/uploads

# E-MAIL EM PRODUÇÃO (Railway bloqueia SMTP fora do plano Pro): use a API do Resend
# Com RESEND_API_KEY definida, as variáveis SMTP_* são ignoradas
RESEND_API_KEY=
MAIL_FROM="Versatti Contabilidade <nao-responda@versatticontabilidade.com.br>"
# Opcional: para onde vão as respostas dos clientes
MAIL_REPLY_TO=contato@versatticontabilidade.com.br
# Intervalo mínimo entre e-mails (ms). Resend: 1000 (padrão). Mailtrap gratuito: 10000
MAIL_MIN_INTERVAL_MS=1000
